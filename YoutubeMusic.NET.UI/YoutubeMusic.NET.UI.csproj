<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS8602;CS8600;CS8601;CS8605;CS1998;CS0067</NoWarn>
    <Version>2026.0202.1</Version>
    <ApplicationIcon>..\logo.ico</ApplicationIcon>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SimpMusic.Lyrics.Client" Version="1.2.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.7" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="YouTubeMusicAPI" Version="3.0.3" />
    <PackageReference Include="YouTubeSessionGenerator" Version="1.0.3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\logo.ico" />
    <EmbeddedResource Include="..\logo.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\YoutubeMusic.NET.Common\YoutubeMusic.NET.Common.csproj" />
  </ItemGroup>
</Project>